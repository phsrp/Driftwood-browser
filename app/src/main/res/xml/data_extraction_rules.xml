<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude the password database from cloud backups and from
     phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="passwords.db" />
        <exclude domain="database" path="passwords.db-journal" />
        <exclude domain="database" path="passwords.db-wal" />
        <exclude domain="database" path="passwords.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="passwords.db" />
        <exclude domain="database" path="passwords.db-journal" />
        <exclude domain="database" path="passwords.db-wal" />
        <exclude domain="database" path="passwords.db-shm" />
    </device-transfer>
</data-extraction-rules>
